#!/usr/bin/env python3
import os
import sys
import json
import subprocess

STATE_FILE = os.path.join(
    os.environ.get("OCI_A1_STATE_DIR", "/var/lib/oci-a1-provisioner"), "state.json"
)
SERVICE_NAME = "oci-a1-provisioner.service"

def get_systemd_status():
    try:
        res = subprocess.run(["systemctl", "is-active", SERVICE_NAME], capture_output=True, text=True)
        active = res.stdout.strip()
        res_sub = subprocess.run(["systemctl", "show", "-p", "SubState", "--value", SERVICE_NAME], capture_output=True, text=True)
        sub = res_sub.stdout.strip()
        return f"{active} ({sub})"
    except Exception as e:
        return f"Unknown ({e})"

def main():
    print("oci-a1-provisioner status")
    print("-" * 60)
    print(f"Service:                 {get_systemd_status()}")

    if not os.path.exists(STATE_FILE):
        print(f"State file:              not found ({STATE_FILE})")
        print("\nThe provisioner has not run yet.")
        return 0

    try:
        with open(STATE_FILE, "r") as f:
            state = json.load(f)
    except Exception as e:
        print(f"Error reading state file: {e}")
        return 1

    attempts = state.get("attempts", 0)
    last_attempt = state.get("last_attempt", "Never")
    last_status = state.get("last_status", "N/A")
    last_error = state.get("last_error", "None")
    target_inst = state.get("target_instance")

    print(f"Total launch attempts:   {attempts}")
    print(f"Last attempt time:       {last_attempt}")
    print(f"Last status:             {last_status}")
    print(f"Last OCI response/error: {last_error}")

    print("-" * 60)
    if target_inst:
        print("Instance:")
        print(f"  Name:            {target_inst.get('display_name')}")
        print(f"  OCID:            {target_inst.get('id')}")
        print(f"  Lifecycle state: {target_inst.get('lifecycle_state')}")
        print(f"  Public IPv4:     {target_inst.get('public_ip') or 'none yet'}")
        print(f"  Shape:           {target_inst.get('shape')} ({target_inst.get('ocpus')} OCPUs / {target_inst.get('memory_in_gbs')} GB)")
        print(f"  AD:              {target_inst.get('ad')}")
        if target_inst.get('public_ip'):
            print(f"\nSSH: ssh ubuntu@{target_inst.get('public_ip')}  (use opc@ on Oracle Linux)")
    else:
        print("Instance:                not created yet")

if __name__ == "__main__":
    sys.exit(main())
